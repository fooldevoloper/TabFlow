{
  "manifest_version": 3,
  "name": "TabFlow - Smart Tab Manager",
  "version": "1.0.0",
  "description": "Automatically organize and group your browser tabs by domain for a cleaner browsing experience.",
  "short_name": "TabFlow",
  "permissions": [
    "tabs",
    "tabGroups",
    "storage",
    "sidePanel"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "popup.html?context=sidepanel"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png",
    "256": "icons/icon128.png"
  },
  "commands": {
    "focus-left": {
      "suggested_key": {
        "default": "Alt+H",
        "mac": "Alt+H"
      },
      "description": "Focus Tab Group Left"
    },
    "focus-right": {
      "suggested_key": {
        "default": "Alt+L",
        "mac": "Alt+L"
      },
      "description": "Focus Tab Group Right"
    },
    "toggle-current-group": {
      "suggested_key": {
        "default": "Alt+E",
        "mac": "Alt+E"
      },
      "description": "Toggle expand/collapse current Tab Group"
    },
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+T",
        "mac": "Alt+T"
      },
      "description": "Open the side panel"
    }
  },
  "homepage_url": "https://github.com/fooldevoloper/TabFlow"
}